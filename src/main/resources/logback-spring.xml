<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console logging with a correlation id, and a mask for long digit runs (phone numbers, IMEIs). -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <conversionRule conversionWord="mask" converterClass="com.ambikatelecom.rewards.common.PiiMaskingConverter"/>

    <property name="CONSOLE_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [cid=%X{correlationId:-}] [%t] %-40.40logger{39} : %mask(%m)%n%mask(%wEx)"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
